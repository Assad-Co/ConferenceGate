# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signs the login session cookie. Required in production —
# without it a random secret is generated at boot and all sessions are
# invalidated on every restart.
JWT_SECRET="MY_JWT_SECRET"

# GOOGLE_SEARCH_API_KEY / GOOGLE_SEARCH_ENGINE_ID: Power the live "Search
# the Web" conference lookup on the Discover page via the Google Custom
# Search JSON API. Get an API key from console.cloud.google.com (enable
# "Custom Search API") and a Search Engine ID from
# programmablesearchengine.google.com. Without these set, the live
# search panel shows a "not configured" message instead of erroring.
GOOGLE_SEARCH_API_KEY="MY_GOOGLE_SEARCH_API_KEY"
GOOGLE_SEARCH_ENGINE_ID="MY_GOOGLE_SEARCH_ENGINE_ID"
