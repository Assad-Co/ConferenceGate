# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signs the login session cookie. Required in production —
# without it a random secret is generated at boot and all sessions are
# invalidated on every restart.
JWT_SECRET="MY_JWT_SECRET"

# BRAVE_SEARCH_API_KEY: Powers the live "Search the Web" conference lookup
# on the Discover page via the Brave Search API. Get a free API key at
# api.search.brave.com (free tier: 2,000 queries/month). Without this set,
# the live search panel shows a "not configured" message instead of erroring.
BRAVE_SEARCH_API_KEY="MY_BRAVE_SEARCH_API_KEY"

# GOOGLE_OAUTH_CLIENT_ID: Powers "Sign in with Google" on the login/signup
# page. Create an OAuth Client ID (Web application) at
# console.cloud.google.com under APIs & Services > Credentials, and add
# this app's URL to "Authorized JavaScript origins". This value is not
# secret and is also exposed to the frontend as VITE_GOOGLE_CLIENT_ID —
# keep both in sync.
GOOGLE_OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"

# --- Conference discovery engine (server/discovery) ---
# All optional. Every one of these missing degrades a capability rather than breaking the app;
# the engine simply does less, or refuses an action, and says so.

# DISCOVERY_ADMIN_TOKEN: required for the mutating discovery admin routes
# (POST /api/admin/discovery/run, /domain, /publish, …). Unset means those routes refuse
# outright rather than defaulting to open — an engine that can crawl the web on request is not
# something to leave reachable by accident. Read-only status/metrics routes need only a signed-in
# account.
DISCOVERY_ADMIN_TOKEN="MY_DISCOVERY_ADMIN_TOKEN"

# DISCOVERY_CONTACT_EMAIL: goes into the crawler's User-Agent so a site operator can reach a
# human about it. Not secret; it appears in every outbound request.
DISCOVERY_CONTACT_EMAIL="discovery@example.org"

# DISCOVERY_PUBLISH_TO_CONFERENCES: set to 1 to allow the discovery engine to write qualifying,
# high-confidence conferences into the app's existing extracted_conferences table, where Discover
# already surfaces them. Off by default: Phase 1 validates and holds rather than publishing.
# Existing rows are never overwritten.
# DISCOVERY_PUBLISH_TO_CONFERENCES="1"

# DISCOVERY_SEARCH_PROVIDER: set to 1 to let discovery use the existing Brave/Serper web-search
# integration as a supplementary source. Off by default so bulk discovery does not spend the
# search quota that Discover's own visitors are using.
# DISCOVERY_SEARCH_PROVIDER="1"

# Politeness and fetch behaviour. The defaults are conservative; a site's own robots.txt
# Crawl-delay can raise the interval but never lower it.
# DISCOVERY_MIN_REQUEST_INTERVAL_MS="1200"
# DISCOVERY_MAX_CONCURRENT_PER_DOMAIN="1"
# DISCOVERY_FETCH_TIMEOUT_MS="15000"
# DISCOVERY_MAX_PAGE_BYTES="3000000"

# Phase 2 providers. Both are interface stubs today and do no work; the flags exist so enabling
# them later is a configuration change rather than a code change.
# DISCOVERY_COMMON_CRAWL="1"
# COMMON_CRAWL_INDEX_URL=""
# DISCOVERY_OPENALEX="1"
