# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Optional but recommended in production. If omitted, ConferenceGate
# generates a secret once and persists it in the database so sessions survive restarts.
JWT_SECRET="MY_JWT_SECRET"

# --- Production web service / billing / paid workspaces ---
# Render should provide PORT automatically; do not hard-code it.
# PUBLIC_BASE_URL is the canonical https origin used by production same-origin checks.
PUBLIC_BASE_URL="https://conferencegate.onrender.com"

# Persistent production database.
# ConferenceGate now defaults to local SQLite. On Render attach a persistent disk at /var/data
# and keep this path inside that disk.
DATABASE_PATH="/var/data/conferencegate.db"

# Legacy Turso credentials are NOT used as the normal runtime database.
# Keep them temporarily configured during recovery so startup can stage the original Professional
# profile and merge legacy conference/discovery rows into persistent SQLite. After recovery is
# verified, they can be unset. They are also accepted by the manual migration/recovery commands.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Server-to-server billing normalization secret. Required.
BILLING_SYNC_SECRET=""

# Paid Organizer/Sponsor workspace checkout. Use "paddle" for server-created Paddle
# subscription checkouts, otherwise use "hosted" with the two hosted checkout URLs.
BILLING_CHECKOUT_PROVIDER="paddle"
ORGANIZER_CHECKOUT_URL=""
SPONSOR_CHECKOUT_URL=""

# Paddle subscription + signed webhook configuration.
PADDLE_API_KEY=""
PADDLE_ENV="live"
PADDLE_ORGANIZER_PRICE_ID=""
PADDLE_SPONSOR_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_WEBHOOK_TOLERANCE_SECONDS="5"

# FastSpring signed webhook configuration when FastSpring is enabled.
FASTSPRING_WEBHOOK_SECRET=""

# Sponsorship settlement / organizer payout behavior.
# Basis points: 250 = 2.5%. Keep 0 until the commercial fee is formally configured.
SPONSORSHIP_PLATFORM_FEE_BPS="0"

# Paid workspace team seats. Server clamps this to 2..1000; default is 10.
WORKSPACE_SEAT_LIMIT="10"

# BRAVE_SEARCH_API_KEY: Powers the live "Search the Web" conference lookup
# on the Discover page via the Brave Search API. Without this set, Serper can
# act as a fallback if SERPER_API_KEY is configured.
BRAVE_SEARCH_API_KEY=""
SERPER_API_KEY=""

# GOOGLE_OAUTH_CLIENT_ID: Powers "Sign in with Google" on the login/signup
# page. Create an OAuth Client ID (Web application) at
# console.cloud.google.com under APIs & Services > Credentials, and add
# this app's URL to "Authorized JavaScript origins". This value is not
# secret and is also exposed to the frontend as VITE_GOOGLE_CLIENT_ID —
# keep both in sync.
GOOGLE_OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"

# LinkedIn OAuth is used only for account identity (openid/profile/email).
# APP_BASE_URL must be the public ConferenceGate origin so the callback resolves to
# <APP_BASE_URL>/api/auth/linkedin/callback.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
APP_BASE_URL="https://conferencegate.onrender.com"

# APIFY_TOKEN: server-only credential used when a signed-in member explicitly presses
# "Import professional profile". ConferenceGate sends that member's public LinkedIn URL to
# harvestapi/linkedin-profile-scraper in "Profile details no email" mode and stores the returned
# experience, education, publications, patents and certifications with provenance. Never expose
# this token to the frontend and never commit the real value.
APIFY_TOKEN=""

# Optional page-reading / enrichment integrations.
JINA_API_KEY=""
FIRECRAWL_API_KEY=""

# --- Conference discovery engine (server/discovery) ---
# All optional. Every one of these missing degrades a capability rather than breaking the app;
# the engine simply does less, or refuses an action, and says so.

# DISCOVERY_ADMIN_TOKEN: required for the mutating discovery admin routes
# (POST /api/admin/discovery/run, /domain, /publish, …). Unset means those routes refuse
# outright rather than defaulting to open — an engine that can crawl the web on request is not
# something to leave reachable by accident. Read-only status/metrics routes need only a signed-in
# account.
DISCOVERY_ADMIN_TOKEN="MY_DISCOVERY_ADMIN_TOKEN"

# DISCOVERY_CONTACT_EMAIL: goes into the crawler's User-Agent so a site operator can reach a
# human about it. Not secret; it appears in every outbound request.
DISCOVERY_CONTACT_EMAIL="discovery@example.org"

# DISCOVERY_PUBLISH_TO_CONFERENCES: set to 1 to allow the discovery engine to write qualifying,
# high-confidence conferences into the app's existing extracted_conferences table, where Discover
# already surfaces them. Off by default: Phase 1 validates and holds rather than publishing.
# Existing rows are never overwritten.
# DISCOVERY_PUBLISH_TO_CONFERENCES="1"

# DISCOVERY_SEARCH_PROVIDER: set to 1 to let discovery use the existing Brave/Serper web-search
# integration as a supplementary source. Off by default so bulk discovery does not spend the
# search quota that Discover's own visitors are using. Brave is always tried first; Serper is only
# reached when Brave's measured yield falls short of the run's target.
# DISCOVERY_SEARCH_PROVIDER="1"

# DISCOVERY_JINA_ENABLED: set to 1 to allow the hosted reader (Jina) to re-read pages a direct
# fetch could not — a page that failed, or came back with under 500 characters of text, which is
# what a JavaScript-rendered shell looks like. Opt-in because it is a paid route, and capped per
# run by the crawl's --max-jina-pages regardless. Every other page is read by plain HTTPS, free.
# DISCOVERY_JINA_ENABLED="1"

# Politeness and fetch behaviour. The defaults are conservative; a site's own robots.txt
# Crawl-delay can raise the interval but never lower it.
# DISCOVERY_MIN_REQUEST_INTERVAL_MS="1200"
# DISCOVERY_MAX_CONCURRENT_PER_DOMAIN="1"
# DISCOVERY_FETCH_TIMEOUT_MS="15000"
# DISCOVERY_MAX_PAGE_BYTES="3000000"

# Phase 2 providers. Both are interface stubs today and do no work; the flags exist so enabling
# them later is a configuration change rather than a code change.
# DISCOVERY_COMMON_CRAWL="1"
# COMMON_CRAWL_INDEX_URL=""
# DISCOVERY_OPENALEX="1"

# ---------------------------------------------------------------------------
# Conference data sources for the launch catalogue (server/dataset/sources/).
#
# Each one missing degrades a capability rather than breaking anything, exactly
# like the variables above. Fetching is separate from building: run the ingest
# on a host with network, commit the caches it writes under data/sources/, and
# the dataset then rebuilds anywhere.
#
#   npx tsx server/dataset/ingest.ts status
#   npx tsx server/dataset/ingest.ts predicthq --max 5000
#   npx tsx server/dataset/ingest.ts openalex
#   npx tsx server/dataset/ingest.ts resolve --max 200
#   npx tsx server/dataset/cli.ts            # rebuild the dataset from the caches
# ---------------------------------------------------------------------------

# PREDICTHQ_ACCESS_TOKEN: the conferences feed — real upcoming events with dates,
# venue and location already structured. The strongest non-official evidence the
# catalogue has. Without it the PredictHQ ingest simply does not run.
# NEVER commit the real value; it belongs in .env, which is gitignored.
PREDICTHQ_ACCESS_TOKEN=""

# EXA_API_KEY: semantic search, used for exactly one job — finding a conference's
# own website, which PredictHQ does not supply. Without it, events that carry no
# resolvable URL stay unpublished rather than being given a guessed link.
EXA_API_KEY=""

# OPENALEX_API_KEY: since February 2026 OpenAlex bills per request against a daily
# budget — around $0.0001 a call, $1/day with a free key, a small fraction of that
# without one, resetting at midnight UTC. A free key is enough for this use
# (enumerating twenty thousand series costs about a penny); without one a shared
# host IP exhausts the budget almost immediately and every call returns 429.
# Get one at https://openalex.org/pricing — it is sent as an api_key URL parameter.
OPENALEX_API_KEY=""

# OPENALEX_CONTACT_EMAIL: a contact address OpenAlex asks callers to identify
# themselves with. Costs nothing and is good manners.
OPENALEX_CONTACT_EMAIL=""

# DISCOVERY_OPENALEX=1 lets the discovery engine enumerate conference series from
# OpenAlex as crawl leads. Off by default, like every other discovery source.
DISCOVERY_OPENALEX="0"
