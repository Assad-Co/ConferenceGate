# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signs the login session cookie. Required in production —
# without it a random secret is generated at boot and all sessions are
# invalidated on every restart.
JWT_SECRET="MY_JWT_SECRET"

# BRAVE_SEARCH_API_KEY: Powers the live "Search the Web" conference lookup
# on the Discover page via the Brave Search API. Get a free API key at
# api.search.brave.com (free tier: 2,000 queries/month). Without this set,
# the live search panel shows a "not configured" message instead of erroring.
BRAVE_SEARCH_API_KEY="MY_BRAVE_SEARCH_API_KEY"

# GOOGLE_OAUTH_CLIENT_ID: Powers "Sign in with Google" on the login/signup
# page. Create an OAuth Client ID (Web application) at
# console.cloud.google.com under APIs & Services > Credentials, and add
# this app's URL to "Authorized JavaScript origins". This value is not
# secret and is also exposed to the frontend as VITE_GOOGLE_CLIENT_ID —
# keep both in sync.
GOOGLE_OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"
